# Copia questo file in `.env.local` e compila i valori effettivi.
# `.env.local` è gitignored, NON committarlo mai.

# --- Sanity (M1) --------------------------------------------------------------
# Project ID e dataset configurati al primo `pnpm dlx sanity init`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Token di lettura per server components (read-only). Generalo da
# manage.sanity.io > API > Tokens con permission "Viewer".
SANITY_API_READ_TOKEN=

# Token di scrittura per script di seed (manage.sanity.io > Editor).
# Usato solo da scripts/seed.ts, MAI esposto al client.
SANITY_API_WRITE_TOKEN=

# --- Resend (M6) --------------------------------------------------------------
# Form contatti, opportunita sponsor, conferme iscrizione SGS + notifica
# admin delle iscrizioni newsletter.
# In modalità sandbox finché il dominio orbassanocalcio.com non è verificato.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Orbassano Calcio <onboarding@resend.dev>

# Casella che riceve le notifiche dei form (segreteria). Default applicato
# in src/lib/mailer.ts se assente: info@orbassanocalcio.com.
CLUB_INBOX_EMAIL=info@orbassanocalcio.com

# --- Brevo (M6) ---------------------------------------------------------------
# Newsletter con double opt-in (DOI) e unsubscribe nativo GDPR. Tutte e tre
# le variabili LIST/TEMPLATE/API devono essere presenti, altrimenti il
# passaggio DOI viene saltato (vedi src/app/api/newsletter/route.ts) e gli
# iscritti arrivano solo come notifica admin via Resend, da aggiungere a mano.
BREVO_API_KEY=
# ID numerico della lista Brevo (CRM > Liste; lo leggi nell'URL .../id/<n>).
BREVO_NEWSLETTER_LIST_ID=
# ID numerico del modello DOI (Marketing > Modelli). Il modello DEVE avere
# il tag "optin" e un pulsante con link {{ doubleoptin }}.
BREVO_DOI_TEMPLATE_ID=
# URL di atterraggio dopo il click di conferma. Default in route.ts:
# https://orbassanocalcio.com/newsletter
BREVO_DOI_REDIRECT_URL=https://orbassanocalcio.com/newsletter

# --- Governance & Codice Etico (in attesa delibera Direttivo) ------------------
# Quando il Direttivo approva il Codice Etico, abilitare le pagine
# /societa/codice-etico, /societa/trasparenza, /societa/segnalazioni
# settando "true". Default off per sicurezza.
NEXT_PUBLIC_FEATURE_GOVERNANCE=false

# Email DEDICATA per le segnalazioni Codice Etico (whistleblowing).
# NON usare info@: riservatezza al Direttivo + Resp. Safeguarding (art. 11.6).
# Configurare lato Workspace come gruppo con membership ristretta.
# Letta da Sanity (riferimentiOperativi.emailSegnalazioni); questa env e'
# fallback per l'API route se il singleton non e' ancora popolato.
WHISTLEBLOWING_INBOX_EMAIL=

# --- Anti-bot Turnstile (M9, post-cutover) ------------------------------------
# Cloudflare Turnstile sul WhistleblowingForm. Disabilitato in MVP:
# honeypot + rate-limit in-memory bastano finche' il sito non e' live.
NEXT_PUBLIC_FEATURE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudinary (M6+ — storage immagini gallery) ------------------------------
# Storage immagini esterno per le gallery foto. 25 credits/mese gratis
# (1 credit = 1GB storage OR 1GB bandwidth OR 1000 transformations).
# Setup:
#   1. Crea account su cloudinary.com (free, no carta credito)
#   2. Dashboard → Settings → Account → Cloud Name (es. "orbacalcio")
#   3. Dashboard → Settings → API Keys → genera API Key + Secret
#   4. Studio settings → API Access → aggiungi una Upload Preset
#      UNSIGNED (per upload dal widget Studio senza esporre il secret)
#   5. Copia i valori qui sotto e nelle env vars Vercel
#
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME: visibile lato client per costruire
# gli URL delivery (https://res.cloudinary.com/{cloud_name}/image/...).
# Non e' un segreto.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# API Key + Secret: usati SOLO dallo Studio embedded per autenticare
# l'upload widget. NON usati lato sito pubblico. CLOUDINARY_API_SECRET
# deve restare server-only (non NEXT_PUBLIC_*).
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload preset UNSIGNED creato dalla dashboard Cloudinary. Usato dal
# widget Studio per uploadare senza esporre l'API secret.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Coming Soon Mode (pre-go-live, M8) ---------------------------------------
# Attiva la modalita' pre-lancio: TUTTE le rotte pubbliche vengono
# riscritte verso /coming-soon (rewrite trasparente, URL nella barra
# resta quello digitato). Implementato via Next.js rewrites in
# next.config.mjs (non via proxy.ts: in Next 16 il proxy gira su
# Node.js runtime e Vercel bypassa le function per i CDN cache).
#
# Eccezioni: /studio (CMS), /api/*, asset statici, sitemap/robots,
# opengraph/twitter image, e chi ha il cookie bypass.
#
# Setta "true" per attivare, "false" o stringa vuota per disattivare.
# Default off. Cambio richiede REDEPLOY su Vercel (rewrites sono
# valutate al build).
#
# Cosa succede in modalita' attiva:
#   - / → coming soon
#   - /squadre, /news, ecc. → coming soon (URL preservata in barra)
#   - /studio → resta accessibile (con basic auth se configurato)
#   - /api/* → resta accessibile (webhook revalidate Sanity, form Resend)
#   - robots.txt → Disallow: /
#   - sitemap.xml → array vuoto
COMING_SOON_MODE=false

# Chiave bypass: visitare /api/preview?key=<KEY> setta un cookie
# httpOnly `cs-bypass=1` che dura 14 giorni e fa vedere il sito reale.
# Per uscire dall'anteprima: /api/preview?reset=1.
# Lascia VUOTA in produzione se non vuoi anteprime, o genera una
# stringa lunga/random (es. uuid).
# Esempio: COMING_SOON_BYPASS_KEY=ORBASSANO-PREVIEW-9F3K-2026
COMING_SOON_BYPASS_KEY=

# --- Studio basic auth (sicurezza /studio) ------------------------------------
# Basic Auth opzionale davanti a /studio gestito da proxy.ts (Next 16
# middleware ex-middleware). Sanity ha gia' la sua auth (richiede login
# account del project), ma esporre l'URL /studio invita crawler/bot. Il
# basic auth a livello edge nasconde lo Studio prima del login Sanity.
# Lascia VUOTI in sviluppo locale: il proxy degrada gracefully (no
# blocco). In produzione Vercel, settare entrambi prima del DNS cutover.
STUDIO_AUTH_USER=
STUDIO_AUTH_PASS=

# --- Vercel (M8) --------------------------------------------------------------
# Configurati automaticamente da Vercel CLI in deploy. In sviluppo locale
# di solito non servono.
# VERCEL_URL=
