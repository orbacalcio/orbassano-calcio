# Copia questo file in `.env.local` e compila i valori effettivi.
# `.env.local` è gitignored, NON committarlo mai.

# --- Sanity (M1) --------------------------------------------------------------
# Project ID e dataset configurati al primo `pnpm dlx sanity init`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Token di lettura per server components (read-only). Generalo da
# manage.sanity.io > API > Tokens con permission "Viewer".
SANITY_API_READ_TOKEN=

# Token di scrittura per script di seed (manage.sanity.io > Editor).
# Usato solo da scripts/seed.ts, MAI esposto al client.
SANITY_API_WRITE_TOKEN=

# --- Resend (M6) --------------------------------------------------------------
# Form contatti, opportunita sponsor, conferme iscrizione SGS.
# In modalità sandbox finché il dominio orbassanocalcio.com non è verificato.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Brevo (M6) ---------------------------------------------------------------
# Newsletter con double opt-in e unsubscribe nativo GDPR.
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Vercel (M8) --------------------------------------------------------------
# Configurati automaticamente da Vercel CLI in deploy. In sviluppo locale
# di solito non servono.
# VERCEL_URL=
